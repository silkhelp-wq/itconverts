# Stripe — from https://dashboard.stripe.com/apikeys  (use TEST keys first: sk_test_…)
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Only needed if you enable the webhook (server/vercel/api/webhook.js)
# From: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# If your static site is on a DIFFERENT domain than this API, lock CORS to it.
# If the API is served from the same domain (recommended), you can leave this as *.
ALLOWED_ORIGIN=*
